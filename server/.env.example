# ---- 必填 ----
# 上游 DeepSeek API Key：只存在服务端，永不下发客户端
DEEPSEEK_API_KEY=

# ---- 监听 ----
HOST=127.0.0.1
PORT=8787
# 对外地址（HTTPS 反代后的域名），用于支付回跳页
PUBLIC_ORIGIN=https://api.example.com
# 与 API 同源托管前端构建产物（可选）
STATIC_DIR=../dist
ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# ---- 计费 ----
# 对用户的加价倍率：1.1 = 官方价 + 10%
PRICE_MARKUP=1.1
SESSION_DAYS=30
# 语音接口（ASR/TTS）每日次数，防止盗刷
VOICE_DAILY_QUOTA=200
MESSAGES_PER_MINUTE=30
AUTH_PER_MINUTE=10

# ---- 支付 ----
# mock：本地联调（App 里显示「模拟支付」）；alipay：手机网站支付，直接跳支付宝
PAY_PROVIDER=mock
ALIPAY_APP_ID=
# 应用私钥 / 支付宝公钥：可填内容，也可填文件路径
ALIPAY_PRIVATE_KEY_FILE=./secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_FILE=./secrets/alipay_public_key.pem
ALIPAY_NOTIFY_URL=https://api.example.com/api/pay/notify
TOPUP_MIN_CNY=1
TOPUP_MAX_CNY=2000

# ---- 本地联调 ----
# 1 = 不访问上游，返回固定流式回复（不产生费用），用于跑通账号与计费链路
MOCK_UPSTREAM=0

DB_PATH=./data/freeseek.db
