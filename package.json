{
  "name": "freeseek",
  "version": "3.0.0",
  "description": "FreeSeek 畅聊：自带 DeepSeek API Key 的安卓聊天客户端，无次数与额度限制。基于官方开源 chat-demo (MIT)。",
  "license": "MIT",
  "private": true,
  "pnpm": {
    "overrides": {
      "katex@<0.18.2": "0.18.2"
    },
    "patchedDependencies": {
      "pptx-browser@4.1.5": "patches/pptx-browser@4.1.5.patch"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rspack build -c rspack.config.ts && node scripts/build-agent-kernel.mjs",
    "build:windows": "pnpm build && node scripts/build-windows.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "test": "node scripts/e2e-check.mjs",
    "test:smoke": "node scripts/smoke.ts",
    "test:compat": "node scripts/check-legacy-bundle.mjs",
    "format": "oxfmt --write .",
    "stats": "node scripts/stats-dashboard.mjs",
    "stats:collect": "node scripts/collect-stats.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-alpha.3",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync-legacy": "npm:@jitl/quickjs-wasmfile-release-sync@0.31.0",
    "@juggle/resize-observer": "3.4.0",
    "@streamparser/json": "0.0.26",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "abortcontroller-polyfill": "1.7.8",
    "clsx": "2.1.1",
    "core-js": "3.51.0",
    "diff": "8.0.3",
    "docx-preview": "0.4.1",
    "es-module-lexer": "2.0.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.18.2",
    "linkedom": "0.18.15",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.16.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.5.438",
    "pptx-browser": "4.1.5",
    "prismjs": "1.30.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ssf": "0.11.2",
    "three": "0.160.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "@types/three": "0.160.0",
    "acorn": "8.19.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WikG1018/FreeSeekApp.git"
  },
  "homepage": "https://github.com/WikG1018/FreeSeekApp",
  "bugs": {
    "url": "https://github.com/WikG1018/FreeSeekApp/issues"
  }
}
